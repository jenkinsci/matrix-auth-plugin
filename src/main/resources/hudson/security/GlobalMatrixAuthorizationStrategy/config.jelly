<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:d="jelly:define" xmlns:st="jelly:stapler" xmlns:f="/lib/form" xmlns:l="/lib/layout">
  <f:block xmlns:local="local">
    <j:set var="groups" value="${descriptor.allGroups}"/>
    <d:taglib uri="local">
      <d:tag name="isEditable">
        <j:choose>
          <j:when test="${readOnlyMode == null}">
            <l:hasPermission permission="${instance.getEditingPermission()}">
              <!--
              While a permission check should be good enough, we prefer readOnlyMode to catch exceptions like node
              properties configured for cloud templates (once https://github.com/jenkinsci/jenkins/pull/4531 is merged):
              A user with Overall/SystemRead can view the form and with global Computer/Configure the user also passes the
              permission check. The user still isn't able to configure the cloud, so we want this to be disabled anyway.

              readOnlyMode is null when the form doesn't set the flag:

                - regular (freestyle) job configuration forms before Jenkins 2.223.
                - folder configuration at least up to cloudbees-folder 6.12 (JENKINS-62218)

              In that case, check for the applicable permission.
              -->
              <d:invokeBody/>
            </l:hasPermission>
          </j:when>
          <j:when test="${not readOnlyMode}">
            <!--
            Allow explicitly setting readOnlyMode = false to render with editing controls despite possible lack of permissions.
            -->
            <d:invokeBody/>
          </j:when>
        </j:choose>
      </d:tag>

      <!-- Render a single permission card for a user/group -->
      <d:tag name="permissionCard">
        <j:set var="cardSid" value="${attrs.sid}"/>
        <j:set var="cardType" value="${attrs.type}"/>
        <j:set var="permissionEntry" value="${descriptor.entryFor(cardType, cardSid)}"/>
        <j:set var="isBuiltIn" value="${(cardSid == 'anonymous' and cardType == 'USER') or (cardSid == 'authenticated' and cardType == 'GROUP')}"/>
        <j:set var="isAmbiguous" value="${cardType == 'EITHER'}"/>
        <j:set var="typeName" value="${descriptor.getTypeLabel(cardType.toLowerCase())}"/>

        <div class="mas-card permission-row ${isAmbiguous ? 'mas-card--ambiguous' : ''} ${readOnlyMode ? 'read-only' : ''}"
             name="[${cardType}:${cardSid}]"
             data-descriptor-url="${descriptor.descriptorFullUrl}"
             data-sid="${cardSid}"
             data-type="${cardType}"
             data-built-in="${isBuiltIn}">

          <!-- Hidden validation target for FormChecker -->
          <div class="mas-card__validation-target" style="display:none" />

          <!-- Card header -->
          <div class="mas-card__header" role="button" tabindex="0"
               aria-expanded="false">
            <div class="mas-card__identity">
              <j:choose>
                <j:when test="${cardType == 'GROUP' or (cardSid == 'authenticated' and cardType == 'GROUP')}">
                  <l:icon src="symbol-people-outline plugin-ionicons-api" class="icon-sm"/>
                </j:when>
                <j:otherwise>
                  <l:icon src="symbol-person-outline plugin-ionicons-api" class="icon-sm"/>
                </j:otherwise>
              </j:choose>
              <span class="mas-card__name">
                <j:choose>
                  <j:when test="${cardSid == 'authenticated' and cardType == 'GROUP'}">${%Authenticated Users}</j:when>
                  <j:when test="${cardSid == 'anonymous' and cardType == 'USER'}">${%Anonymous}</j:when>
                  <j:otherwise>${cardSid}</j:otherwise>
                </j:choose>
              </span>
              <j:if test="${isAmbiguous}">
                <span class="mas-card__badge mas-card__badge--warning">${%ambiguousLabel}</span>
              </j:if>
            </div>
            <div class="mas-card__summary" data-empty-text="${%noPermissions}">
              <!-- Populated by JS -->
            </div>
            <div class="mas-card__actions">
              <local:isEditable>
                <button type="button" class="jenkins-button jenkins-button--tertiary mas-card__action selectall"
                        tooltip="${%selectall(cardSid)}">
                  <l:icon src="symbol-select-all plugin-matrix-auth" class="icon-sm"/>
                </button>
                <button type="button" class="jenkins-button jenkins-button--tertiary mas-card__action unselectall"
                        tooltip="${%unselectall(cardSid)}">
                  <l:icon src="symbol-unselect-all plugin-matrix-auth" class="icon-sm"/>
                </button>
                <j:if test="${not isBuiltIn}">
                  <button type="button" class="jenkins-button jenkins-button--tertiary jenkins-!-destructive-color mas-card__action remove"
                          tooltip="${%remove(cardSid)}">
                    <l:icon src="symbol-trash-outline plugin-ionicons-api" class="icon-sm"/>
                  </button>
                </j:if>
                <j:if test="${isAmbiguous}">
                  <button type="button" class="jenkins-button jenkins-button--tertiary mas-card__action migrate migrate_user"
                          tooltip="${%migrate_user(cardSid)}">
                    <l:icon src="symbol-person-outline plugin-ionicons-api" class="icon-sm"/>
                  </button>
                  <button type="button" class="jenkins-button jenkins-button--tertiary mas-card__action migrate migrate_group"
                          tooltip="${%migrate_group(cardSid)}">
                    <l:icon src="symbol-people-outline plugin-ionicons-api" class="icon-sm"/>
                  </button>
                </j:if>
              </local:isEditable>
              <div class="mas-card__toggle">
                <l:icon src="symbol-chevron-down-outline plugin-ionicons-api" class="icon-sm"/>
              </div>
            </div>
          </div>

          <div class="mas-card__body mas-card__body--collapsed">
            <j:forEach var="g" items="${groups}">
              <j:set var="hasVisiblePermissions" value="${false}"/>
              <j:forEach var="p" items="${g.permissions}">
                <j:if test="${descriptor.showPermission(p)}">
                  <j:set var="hasVisiblePermissions" value="${true}"/>
                </j:if>
              </j:forEach>
              <j:if test="${hasVisiblePermissions}">
                <fieldset class="mas-card__permission-group">
                  <legend class="mas-card__group-title">${g.title}</legend>
                  <div class="mas-card__permissions">
                    <j:forEach var="p" items="${g.permissions}">
                      <j:if test="${descriptor.showPermission(p)}">
                        <j:set var="isChecked" value="${permissionEntry != null and instance.hasExplicitPermission(permissionEntry,p)}"/>
                        <label class="mas-card__permission jenkins-checkbox"
                               data-implied-by-list="${descriptor.impliedByList(p)}"
                               data-permission-id="${p.id}">
                          <input type="checkbox" name="[${p.id}]" checked="${isChecked?'checked':null}"/>
                          <span class="mas-card__permission-name">${p.name}</span>
                          <span class="mas-card__permission-implied" hidden="true">(${%implied})</span>
                          <j:set var="permDescription" value="${descriptor.getDescription(p)}"/>
                          <j:if test="${permDescription != null and permDescription.length() > 0}">
                            <span class="mas-card__permission-info" data-html-tooltip="${permDescription}">
                              <l:icon src="symbol-help-circle" class="icon-sm"/>
                            </span>
                          </j:if>
                        </label>
                      </j:if>
                    </j:forEach>
                  </div>
                </fieldset>
              </j:if>
            </j:forEach>
          </div>
        </div>
      </d:tag>
    </d:taglib>

    <j:set var="strategyid" value="${descriptor.jsonSafeClassName}" />

    <!-- Search / filter -->
    <div class="mas-container" id="${strategyid}" name="data">
      <local:isEditable>
        <div class="mas-app-bar">
          <div class="mas-search-wrapper">
            <l:search-bar placeholder="${%searchPlaceholder}"
                          clazz="mas-search"
                          hasKeyboardShortcut="false" />
            <div class="mas-filter">
              <button type="button" class="jenkins-button jenkins-button--tertiary mas-filter__button"
                      aria-expanded="false" aria-haspopup="true"
                      tooltip="${%filterLabel}">
                <l:icon src="symbol-funnel-outline plugin-ionicons-api" class="icon-sm"/>
              </button>
              <div class="mas-filter__dropdown" hidden="true">
                <div class="mas-filter__header">
                  <span class="mas-filter__header-label">${%filterLabel}</span>
                  <button type="button" class="mas-filter__reset-button" hidden="true">${%resetFilters}</button>
                </div>
                <div class="mas-filter__search">
                  <input type="text" class="jenkins-input mas-filter__search-input" placeholder="${%filterSearchPlaceholder}" />
                  <button type="button" class="mas-filter__search-clear" aria-label="Clear">&#xd7;</button>
                </div>
                <div class="mas-filter__list">
                  <j:forEach var="g" items="${groups}">
                    <j:set var="hasFilterPerms" value="${false}"/>
                    <j:forEach var="p" items="${g.permissions}">
                      <j:if test="${descriptor.showPermission(p)}">
                        <j:set var="hasFilterPerms" value="${true}"/>
                      </j:if>
                    </j:forEach>
                    <j:if test="${hasFilterPerms}">
                      <div class="mas-filter__group-title">${g.title}</div>
                      <j:forEach var="p" items="${g.permissions}">
                        <j:if test="${descriptor.showPermission(p)}">
                          <button type="button" class="mas-filter__item" data-filter-permission="${p.id}" data-filter-label="${g.title} ${p.name}">
                            <span class="mas-filter__item-indicator"></span>
                            <span class="mas-filter__item-name">${p.name}</span>
                          </button>
                        </j:if>
                      </j:forEach>
                    </j:if>
                  </j:forEach>
                  <div class="mas-filter__no-results" hidden="true">${%filterNoResults}</div>
                </div>
              </div>
            </div>
          </div>
          <button type="button" class="jenkins-button matrix-auth-add-button"
                  data-type="USER"
                  data-type-label="${%user}"
                  data-message-prompt="${%userPrompt}"
                  data-message-title="${%Add user}"
                  data-message-error="${%userError}">${%Add user}</button>
          <button type="button" class="jenkins-button matrix-auth-add-button"
                  data-type="GROUP"
                  data-type-label="${%group}"
                  data-message-prompt="${%groupPrompt}"
                  data-message-title="${%Add group}"
                  data-message-error="${%groupError}">${%Add group}</button>
        </div>
      </local:isEditable>

      <!-- Ambiguity warning -->
      <j:if test="${descriptor.hasAmbiguousEntries(instance)}">
        <div class="jenkins-alert jenkins-alert-warning mas-ambiguity-warning">
          ${%ambiguous}
        </div>
      </j:if>

      <!-- Permission cards -->
      <div class="mas-cards">
        <!-- Custom entries -->
        <j:forEach var="entry" items="${instance.allPermissionEntries}">
          <j:if test="${entry.sid != 'authenticated' or entry.type.toString() != 'GROUP'}">
            <local:permissionCard sid="${entry.sid}" type="${entry.type.toString()}" />
          </j:if>
        </j:forEach>

        <!-- Built-in entries -->
        <local:permissionCard type="USER" sid="anonymous" />
        <local:permissionCard type="GROUP" sid="authenticated" />
      </div>

      <!-- Empty state when search filters everything -->
      <div class="jenkins-notice mas-empty-state" hidden="true">
        <l:icon src="symbol-search" />
        ${%noResults}
      </div>
    </div>

    <!-- Template card for dynamically added users/groups -->
    <j:set var="templateId" value="${h.generateId()}"/>
    <template id="${templateId}" data-strategy-id="${strategyid}">
      <local:permissionCard sid="__SID__" type="USER" />
    </template>

    <!-- Pre-rendered icons for JS to clone when swapping user/group icons -->
    <div id="${strategyid}-icons" hidden="true">
      <span data-icon-type="USER"><l:icon src="symbol-person-outline plugin-ionicons-api" class="icon-sm"/></span>
      <span data-icon-type="GROUP"><l:icon src="symbol-people-outline plugin-ionicons-api" class="icon-sm"/></span>
    </div>

    <st:adjunct includes="hudson.security.table"/>
  </f:block>
</j:jelly>
